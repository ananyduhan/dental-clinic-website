# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL=
# Direct connection (port 5432) — used by `prisma migrate` only, which
# cannot run through PgBouncer's transaction pooler.
DIRECT_URL=

# ─── Auth (NextAuth.js v5) ───────────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourclinic.com

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Storage (Supabase) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error Tracking (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Cron Security ───────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Clinic ──────────────────────────────────────────────────────────────────
# IANA timezone. All DB times are UTC; this is the display/conversion boundary.
CLINIC_TIMEZONE=Australia/Sydney

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Demo mode ─────────────────────────────────────────────────────────────
# "true" on the public portfolio deployment. Registration then creates accounts
# already verified (no mail provider can reach a stranger's inbox from a
# *.vercel.app URL) and the sign-in page offers one-click demo accounts, which
# are the only way to reach the admin dashboard. Leave unset for a real clinic.
NEXT_PUBLIC_DEMO_MODE=
